{
  "name": "cat-o-meter",
  "displayName": "Cat-O-Meter",
  "description": "%extension.description%",
  "version": "1.3.0",
  "publisher": "EvePulido",
  "icon": "media/icon-halloween.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/EvePulido/Cat-O-Meter.git"
  },
  "homepage": "https://github.com/EvePulido/Cat-O-Meter.git",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "cat",
    "gato",
    "errors",
    "fun",
    "diagnostic",
    "meme",
    "productivity"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "cat-o-meter.view",
          "name": "Cat-O-Meter",
          "icon": "media/icon.svg"
        }
      ]
    },
    "configuration": {
      "title": "Cat-O-Meter",
      "properties": {
        "catOMeter.imagePack": {
          "type": "string",
          "enum": [
            "auto",
            "classic",
            "halloween"
          ],
          "enumDescriptions": [
            "%config.imagePack.auto%",
            "%config.imagePack.classic%",
            "%config.imagePack.halloween%"
          ],
          "default": "auto",
          "description": "%config.imagePack.description%"
        }
      }
    },
    "commands": [
      {
        "command": "cat-o-meter.selectPack",
        "title": "%command.selectPack.title%",
        "icon": "$(gear)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "cat-o-meter.selectPack",
          "when": "view == cat-o-meter.view",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "jest"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "typescript": "^5.3.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^vscode$": "<rootDir>/src/__mocks__/vscode.ts"
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/out/"
    ]
  }
}