{
  "name": "cat-o-meter",
  "displayName": "Cat-O-Meter",
  "description": "Tu gato reacciona a los errores de tu código",
  "version": "1.0.2",
  "publisher": "EvePulido",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/EvePulido/Cat-O-Meter.git"
  },
  "homepage": "https://github.com/EvePulido/Cat-O-Meter.git",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "cat",
    "gato",
    "errors",
    "fun",
    "diagnostic",
    "meme",
    "productivity"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "cat-o-meter.view",
          "name": "Cat-O-Meter",
          "icon": "media/icon.svg"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  }
}
