{
  "name": "cat-o-meter",
  "displayName": "Cat-O-Meter",
  "description": "A cat reacting to your code errors",
  "version": "1.1.2",
  "publisher": "EvePulido",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/EvePulido/Cat-O-Meter.git"
  },
  "homepage": "https://github.com/EvePulido/Cat-O-Meter.git",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "cat",
    "gato",
    "errors",
    "fun",
    "diagnostic",
    "meme",
    "productivity"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "cat-o-meter.view",
          "name": "Cat-O-Meter",
          "icon": "media/icon.svg"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "jest"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "typescript": "^5.3.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^vscode$": "<rootDir>/src/__mocks__/vscode.ts"
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/out/"
    ]
  }
}